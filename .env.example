# 数据库连接配置（PostgreSQL 16 + asyncpg）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_matrix_hub

# Fernet 对称加密密钥（可使用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成）
FERNET_KEY=

# OpenAI 兼容大模型接口配置（用于多频道 AI 翻译转发）
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

